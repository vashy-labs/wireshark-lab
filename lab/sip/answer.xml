<?xml version="1.0" encoding="ISO-8859-1" ?>
<!-- Wireshark lab: a phone that rings, answers, talks (G.711 a-law) until the caller hangs up.
     @SDPIP@ is replaced by the address the phone announces for its audio. -->
<scenario name="Lab answering phone">
  <recv request="INVITE" crlf="true"/>
  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:1001@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>
  <pause milliseconds="1500"/>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:1001@[local_ip]:[local_port]>
      User-Agent: Lab phone
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=1001 53655765 2353687637 IN IP4 @SDPIP@
      s=Lab call
      c=IN IP4 @SDPIP@
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000
      a=ptime:30
      a=sendrecv
    ]]>
  </send>
  <recv request="ACK" rtd="true" crlf="true"/>
  <nop>
    <action>
      <exec play_pcap_audio="@PCAP@"/>
    </action>
  </nop>
  <recv request="BYE"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:1001@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>
</scenario>
